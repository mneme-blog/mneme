# Production secrets/config — copy to .env.prod and fill in real values.
# .env.prod is gitignored; never commit it.

# Postgres superuser password (bookkeeping DB; opaque blobs only).
POSTGRES_PASSWORD=

# MinIO root credentials — also used by the relay as its S3 credentials.
MINIO_ROOT_USER=mneme
MINIO_ROOT_PASSWORD=

# Bearer token for the operator dashboard at /admin.
# Leave empty to disable the admin surface entirely (it 404s).
ADMIN_TOKEN=

# Operator approval for NEW vaults. Off by default = an open relay (anyone who
# can reach it can store their own encrypted journals on it). Set to true to run
# a single-tenant / hand-picked relay: a newly registered vault lands "pending"
# and can't sync until you approve it in /admin (so set ADMIN_TOKEN above too).
# Vaults that already exist are grandfathered to approved. See docs/API.md "Admin".
REQUIRE_APPROVAL=false

# The dashboard checks GitHub once/hour for a newer release and shows a banner
# when one exists. This is the relay's only outbound call; set to off/false/0 to
# disable it for air-gapped deployments. Defaults to on.
UPDATE_CHECK=on

# One-click updates from /admin ("Update to vX.Y.Z" + "Roll back").
#
# Off unless BOTH lines below are set AND the host agent is installed:
#
#     sudo ./deploy/updater/install.sh
#
# The relay never gains host access. It writes an update request into the shared
# spool directory; a root-owned systemd unit on the host picks it up, takes a
# backup, pulls the released images, restarts the stack, waits for it to report
# healthy, and rolls back automatically if it does not. Anyone holding
# ADMIN_TOKEN can therefore trigger a stack restart onto a published Mneme
# release — which is the intended power, and a reason to keep that token good.
# See docs/MAINTENANCE.md "One-click updates".
#
# UPDATE_SPOOL_HOST_DIR is the directory on the host (must match the agent's
# SPOOL_DIR); UPDATE_SPOOL_DIR is where it is mounted in the container, and is
# the switch that actually shows the button. Leave both unset to keep updates
# a manual, on-the-host operation.
#UPDATE_SPOOL_HOST_DIR=/var/lib/mneme/spool
#UPDATE_SPOOL_DIR=/var/lib/mneme/spool

# Addresses Caddy answers on (comma-separated: LAN IP, hostname, …).
# The client bundle is hostname-agnostic, so add whatever your LAN resolves.
SITE_ADDRESS=192.168.68.71, cortex.local

# Certificate served when a client connects by bare IP (sends no SNI).
DEFAULT_SNI=

# Host directory where rolling backup archives land (created if missing).
BACKUP_HOST_DIR=/home/particle/mneme-backups

# Backup cadence and retention (newest first; 0 keeps all).
BACKUP_INTERVAL=24h
BACKUP_KEEP=14

# Rate limiting for the unauthenticated auth endpoints, per client IP.
# 0 disables it. See server/.env.example for the full explanation.
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_AUTH_BURST=15

# This deployment puts Caddy in front of the relay, so the socket address is
# always Caddy's. Keep this on so rate limiting sees real client addresses.
# One trusted hop (Caddy); if you add another proxy in front, re-check this.
TRUST_PROXY_HEADERS=true

# Per-owner storage quota in bytes (entry ciphertext + finalized media).
# 0 = unlimited. Set a real number if this relay is reachable from the internet.
QUOTA_BYTES_PER_OWNER=0

# Speech-to-text model installed into the bundled whisper server on `up`
# (the whisper-model one-shot). Speaches does not fetch models on demand — an
# uninstalled model makes every transcription answer 404 — so this must match
# the client's default (DEFAULT_TRANSCRIPTION_MODEL in apps/client/src/ai/types.ts)
# unless you also change it in the app's AI settings.
#
# The default is whisper large-v3-turbo: ~1.6 GB downloaded once on first `up`,
# and the first model that transcribes non-English speech well enough to be
# worth reading. On a small box you can trade accuracy back for speed with
# Systran/faster-whisper-medium (~1.5 GB) or Systran/faster-whisper-small
# (~0.5 GB) — change it in the app's AI settings to match.
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2

# CTranslate2 quantization for the whisper container. int8 is the right CPU
# default (a third of float32's memory, faster, no meaningful accuracy loss).
# On a GPU host, float16 is the usual choice.
WHISPER_COMPUTE_TYPE=int8
