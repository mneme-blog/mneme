# LAN-facing entry point. SITE_ADDRESS comes from .env.prod and may list
# several addresses (IP, hostname) separated by commas.
#
# `tls internal` uses Caddy's own CA: browsers warn once per device (proceed,
# or install the root cert from the caddy_data volume under
# pki/authorities/local/root.crt to make the warning go away). HTTPS is not
# optional — the client needs a secure context for OPFS storage and media
# capture, which plain http:// on a LAN IP does not provide.
#
# default_sni: browsers hitting a bare IP send no SNI; without this Caddy
# can't pick a certificate and aborts the handshake.

{
	default_sni {$DEFAULT_SNI}
	fallback_sni {$DEFAULT_SNI}
}

{$SITE_ADDRESS} {
	tls internal
	encode zstd gzip

	# Everything lives under /mneme; the rest of the origin stays free for
	# other services on this host. Bare / redirects for convenience (302 so a
	# future root site isn't shadowed by a cached permanent redirect).
	#
	# ⚠️ SECURITY: co-hosting is a path-level convenience, not an isolation
	# boundary. The browser's boundary is the ORIGIN (scheme + host + port), and
	# everything on this origin shares one localStorage, one IndexedDB — which
	# holds the sealed-seed keystore — and one OPFS, which holds the decrypted
	# journal database. Another app served from this origin can read and write
	# all of it, and can register a service worker that intercepts Mneme's own
	# requests. The seal is encrypted, so a hostile neighbour can't trivially
	# read the seed, but it can tamper with storage and serve replaced app code.
	#
	# Give Mneme a dedicated origin (its own subdomain) whenever anything else
	# is served from this host. See docs/SECURITY.md §6.13.
	redir / /mneme/ 302
	redir /mneme /mneme/

	handle_path /mneme/* {
		# handle_path strips the /mneme prefix, so the relay and the SPA
		# see root-relative paths exactly as before.

		# Relay API + health + operator admin surface → Go server.
		handle /v1/* {
			reverse_proxy server:8080
		}
		handle /healthz {
			reverse_proxy server:8080
		}
		handle /readyz {
			reverse_proxy server:8080
		}
		handle /admin* {
			reverse_proxy server:8080
		}

		# Everything else is the client SPA.
		handle {
			root * /srv

			# --- Security headers -------------------------------------------
			# The CSP is the mitigation CLAUDE.md §6 relies on to make keys
			# living in JS memory while unlocked acceptable: without it, any
			# script injection reads the seed and every plaintext entry, and
			# the loss is unrecoverable (the mnemonic is the only anchor).
			#
			# Keep the policy in sync with apps/client/csp.js, which injects the
			# same string as a <meta> fallback into the build. Regenerate with
			# `pnpm --filter client csp`. Browsers intersect a header policy and
			# a meta policy, so a drifted pair silently over-restricts.
			#
			# CSP_CONNECT_EXTRA (space-separated, e.g. "https://relay.example.com")
			# adds connect-src origins. Not needed for this deployment — /v1/* is
			# proxied under the app's own origin below, so 'self' covers the relay.
			# You do need it for an Ollama or transcription server that isn't on
			# loopback (the localhost:* wildcards cover any loopback port).
			header {
				Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' blob: data: https://tile.openstreetmap.org; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; connect-src 'self' blob: https://api.anthropic.com https://nominatim.openstreetmap.org http://localhost:11434 http://127.0.0.1:11434 http://localhost:* http://127.0.0.1:* {$CSP_CONNECT_EXTRA}; frame-ancestors 'none'"
				# No MIME sniffing: a blob served with the wrong type must not be
				# reinterpreted as script.
				X-Content-Type-Options "nosniff"
				# Belt-and-braces with frame-ancestors, for anything that predates it.
				X-Frame-Options "DENY"
				# Entry URLs are client-side only, but never leak a path to a
				# third party (tile/geocoder/AI requests) regardless.
				Referrer-Policy "no-referrer"
				# The app asks for camera/microphone (media capture) and
				# geolocation (location blocks) from its own context only;
				# everything else is denied outright.
				Permissions-Policy "accelerometer=(), autoplay=(), camera=(self), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), usb=(), xr-spatial-tracking=()"
				# Caddy advertises itself by default; nothing gains from that.
				-Server
			}

			# Fingerprinted build output (/assets/*.<hash>.js|css) never changes
			# under its hashed name — let clients cache it forever.
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"

			# Everything else — the HTML shell, the service worker (sw.js /
			# registerSW.js / workbox-*.js), and the web manifest — must be
			# revalidated on every launch. Without this Caddy/Chrome may serve a
			# cached sw.js for up to 24h, so an installed PWA keeps running the old
			# worker (and its precached shell) even after a cold restart. `no-cache`
			# = store but always revalidate with the origin before use, so a new
			# build is picked up on the next launch. (Header matchers evaluate on
			# the original request path, before try_files rewrites to /index.html,
			# so client-routed navigations get no-cache too.)
			@revalidate not path /assets/*
			header @revalidate Cache-Control "no-cache"

			try_files {path} /index.html
			file_server
		}
	}

	# Nothing lives outside /mneme (yet) — don't answer with empty 200s.
	handle {
		respond 404
	}
}
