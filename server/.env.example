# Copy to .env (gitignored) and adjust. These _dev defaults match docker-compose.yml.
DATABASE_URL=postgres://journal:journal_dev@localhost:5432/journal?sslmode=disable
LISTEN_ADDR=:8080
SESSION_TTL=24h

# CORS: comma-separated allowed origins, or "*" to reflect any (dev default).
# In production set this to your client origin(s), e.g. https://mneme.app — or
# to the EMPTY string for a same-origin deployment behind a reverse proxy,
# which allows no cross-origin caller at all. Empty and unset mean different
# things here: unset falls back to "*".
#
# Reflecting any origin is safe *today* only because auth is a Bearer header
# and no cookie is ever set. If credentials are ever added, "*" becomes an
# account-takeover bug — the invariant is: never reflect an arbitrary origin
# together with Access-Control-Allow-Credentials.
CORS_ORIGINS=*

# Media object storage (S3-compatible). Leave S3_ENDPOINT empty to run without
# media (media endpoints answer 503).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev
S3_BUCKET=journal-media

# Admin dashboard (/admin): aggregate stats only, never per-user detail. Leave
# empty (or unset) to disable the admin surface entirely (every /admin path 404s).
# In production use a long random secret, e.g.: openssl rand -base64 32
ADMIN_TOKEN=admin_dev

# Operator approval for NEW vaults. Off by default (open, trust-on-first-use).
# Set true to run a single-tenant / hand-picked relay: a newly registered owner
# is 'pending' and can't authenticate until you approve it in /admin. Owners that
# already exist are grandfathered to approved. Needs ADMIN_TOKEN to approve.
REQUIRE_APPROVAL=false

# Rate limiting for the three unauthenticated endpoints (/v1/register,
# /v1/auth/challenge, /v1/auth/verify). They are the only way in, so leaving
# them unbounded lets anyone create owners and consume storage anonymously.
# Per client IP, token bucket, in-process. Set either to 0 to disable (only
# sensible if a reverse proxy already throttles). A sign-in is three calls, so
# the defaults are invisible in normal use.
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_AUTH_BURST=15

# Guesses at ADMIN_TOKEN, per client IP. Only FAILED admin authentications are
# charged, so the dashboard's polling (which holds a valid token) never spends
# from this — which is why it can be far tighter than the budget above.
RATE_LIMIT_ADMIN_PER_MINUTE=10
RATE_LIMIT_ADMIN_BURST=10

# Read the client address from X-Forwarded-For / X-Real-IP instead of the
# socket. Turn this on ONLY when the relay really is behind a trusted proxy —
# otherwise a client can set those headers itself and rotate around the rate
# limiter. The RIGHT-most X-Forwarded-For entry is used (proxies append rather
# than replace, so the left-most one is caller-controlled), which assumes
# exactly one trusted hop.
TRUST_PROXY_HEADERS=false

# Per-owner storage quota in bytes: entry ciphertext + finalized media.
# 0 = unlimited (the right default for a single-tenant/family relay, the wrong
# one for anything internet-facing). Example: 5 GiB = 5368709120.
QUOTA_BYTES_PER_OWNER=0
